# Docker Compose 会为未配置项使用 docker-compose.yml 中的开发默认值。
# 部署到服务器前请复制为 .env，并更换所有密码、JWT 密钥和 OSS 配置。
HTTP_PORT=80
HTTPS_PORT=443
TZ=Asia/Shanghai

MYSQL_ROOT_PASSWORD=replace-with-a-long-root-password
MYSQL_PASSWORD=replace-with-a-long-app-password
REDIS_PASSWORD=replace-with-a-long-redis-password

USER_JWT_SECRET_KEY=replace-with-a-long-user-jwt-secret
ADMIN_JWT_SECRET_KEY=replace-with-a-long-admin-jwt-secret
REPAIR_JWT_SECRET_KEY=replace-with-a-long-repair-jwt-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
SUPER_ADMIN_USERNAME=superadmin123

ALIYUN_OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret
ALIYUN_OSS_REGION=cn-hangzhou
ALIYUN_OSS_BUCKET_NAME=replace-with-oss-bucket-name
IMAGE_MAX_SIZE=5
IMAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp
IMAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,image/webp

# 未配置 SMTP 时，除邮箱验证码外的业务仍可正常启动。
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=校园设备管理系统
MAIL_PORT=465
MAIL_SERVER=
MAIL_STARTTLS=false
MAIL_SSL_TLS=true
EMAIL_VERIFICATION_CODE_EXPIRE_SECONDS=60

REDIS_SOCKET_TIMEOUT=0.5
EQUIPMENT_QUERY_CACHE_TTL=300
